# Python environments: rebuilt by the run scripts, never committed
envs/
.venvs/
.venv/
__pycache__/
*.pyc

# Generated by examples/multi-change-example/run_all.sh (expected/ holds the record)
examples/multi-change-example/data/
examples/multi-change-example/results/

# Secrets: API keys must never be committed
.env
.env.*
*.key
secrets/

# macOS and Word temporary files
.DS_Store
~$*
